# Pooled Neon connection string for application traffic (required for auth and database features)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Direct Neon connection string for Drizzle migrations (DATABASE_URL_UNPOOLED from Neon)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend transactional email (required for password recovery)
RESEND_API_KEY=
AUTH_EMAIL_FROM="ProofWork <no-reply@your-verified-domain.example>"

# OpenAI
OPENAI_API_KEY=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
